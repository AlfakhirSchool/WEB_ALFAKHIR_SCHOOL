# Canonical public URL of the site (used for metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://example.com

# PostgreSQL for the dashboard (page text edits, settings, popup, uploaded images).
# Vercel: use a Neon / Supabase / Vercel Postgres connection string. Apply the schema with `npm run db:push`.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret for signing admin login sessions (min. 32 chars). Generate: openssl rand -hex 32
AUTH_SECRET=

# First admin account: on a fresh database, logging in with these creates the account.
# Change the password from Dashboard → Akun afterwards (these values are then no longer used).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: any JSON webhook (Google Apps Script / Make / Zapier URL).
# Receives POST {"source": string, "fields": {...}, "receivedAt": ISO string} for each form submission.
LEAD_WEBHOOK_URL=

# Optional: Plausible analytics domain (e.g. example.com)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
